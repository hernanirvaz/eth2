#!/bin/bash
# Temporary protections for CVE-2026-98432
# Safe to use with UFW (does NOT touch nftables.service)

function cex { echo "$H"|sudo -S -p '' "$@" &>/dev/null; }

cex nft delete table ip cve_2026_98432 || true
cex nft add table ip cve_2026_98432
cex nft add chain ip cve_2026_98432 pre '{ type filter hook prerouting priority -300; }'
cex nft add rule ip cve_2026_98432 pre meta l4proto tcp ip hdrlength gt 5 counter drop

if cex nft list table ip cve_2026_98432; then
    echo "$(date +"%Y-%m-%d %H:%M:%S") CVE-2026-98432 Protections ACTIVE."
else
    echo "$(date +"%Y-%m-%d %H:%M:%S") [ERROR] Failed to load table 'cve_2026_98432'!"
    exit 1
fi
