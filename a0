 }
function sns {
  local s=$1
  if [[ ${#1} -eq 2 ]]; then
    if [[ ${1:0:1} = z ]]; then
      if [[ ${1:1:1} -le 4 ]]; then
        s=${1/z/hrv-zotac}
      else
        s=${1/z/hrv-intel}
      fi
    else
      case $1 in
      v1) s=$vnd1 ;;
      v2) s=$vnd2 ;;
      v3) s=$vnd3 ;;
       *) s=$1 ;;
      esac
    fi
  fi
  snu $(sin "$s")
}
function stt { [[ $cut1 != $cut2 ]]; }
function sxt { [[ $cunm = $cut1 || $cunm = $cut2 ]]; }
function sst { local s=${1:-$cunm};[[ $s != hrv-zen && $s != hrv-lenovo ]]; }
function msh { 
  if [[ $# -lt 1 ]];then 
    echo -e "msh [user@]{server} [port] [command]\t\tssh -4p <port> <server> '<command>'"
    return
  fi
  local s;local p;local e;local i;local u;local w
  while [[ $# -gt 0 ]];do i=$(sns "${1#*@}");[[ "$1" == *'@'* ]] && u=${1%@*};[[ $u ]] || if [[ "$i" == *'@'* ]];then u=${i%@*};fi
      if [[ "$1" =~ ^[0-9]+$ ]]; then
        p=$1
      elif [[ "$1" == -q ]]; then
        w=no
      elif sit "${i#*@}"; then
        e="$1";[[ $w = no ]] || w=''
      else
       [[ $u ]] && u=$u@;s="$u${i#*@}";[[ $p ]] || p=$(spn $s)
      fi
      shift
  done
  [[ $w ]] || echo ssh -4p $p $s $e;ssh -4p $p $s "$e" 2>/dev/null
}
function mcp {
  if [[ $# -lt 1 ]];then 
    echo -e "mcp [port] {zv}{123456}:{file|dir} [d:~]\t\tscp -4rP <port> <server>:{file|dir} <destination>"
    echo -e "mcp [port] {file|dir} {zv}{123456}:[d:~]\t\tscp -4rP <port> {file|dir} <server>:<destination>"
    return
  fi
  local a=();local s;local f;local p;local w
  while [[ $# -gt 0 ]];do s="$1"
      if [[ "$s" == *:* ]] && [[ "$s" != -* ]] && [[ ! "$s" =~ ^(\.|/) ]]; then
        f=${s##*:};s=$(sns "${s%:*}");[[ $p ]] || p=$(spn "${s%:*}");a+=("$s:$f")
      elif [[ "$s" == -q ]]; then
        w=no
      elif [[ "$s" =~ ^[0-9]+$ ]]; then
        p=$s
      else
        a+=("$s")
      fi
      shift
  done
  [[ $w ]] || echo scp -4rP $p ${a[@]};scp -4rP $p "${a[@]}" 2>/dev/null
}
function leh { echo -e "leo <param>\nLEORB\treboot\nlog\tdmesg\nxml\tconfig\nos\tOptical Signal\nvl\tVLANs\nmac\tMAC Bridge Configuration Data\nuni\tPhysical Path Termination Point Ethernet UNI\ntd\tTraffic Descriptor\nolt\tOLT revealing its own identity\nver\tSoftware is currently running\nont\tONT revealing its own identity\npon\tGPON State Machine\nupt\tUptime"; }
function ltl { expect -c "spawn telnet 192.168.100.1;expect \"ogin:\";send \"leox\r\";expect \"assword:\";send \"$V\r\";expect \"#\";send \"$*\r\";expect \"$*\";expect \"#\";send \"exit\r\";expect eof"; }
function leo { 
  if   [[ $1 = LEORB ]];then ltl reboot
  elif [[ $1 = log   ]];then ltl dmesg
  elif [[ $1 = xml   ]];then ltl flash all
  elif [[ $1 = os    ]];then ltl omcicli mib get 263 | tr -d '\r' | awk "$om02;$om01"
  elif [[ $1 = vl    ]];then ltl omcicli mib get 84  | tr -d '\r' | awk "$om03;$om01"
  elif [[ $1 = mac   ]];then ltl omcicli mib get 47  | tr -d '\r' | awk "$om07;$om01"
  elif [[ $1 = uni   ]];then ltl omcicli mib get 11  | tr -d '\r' | awk "$om08;$om01"
  elif [[ $1 = td    ]];then ltl omcicli mib get 280 | tr -d '\r' | awk "$om09;$om01"
  elif [[ $1 = olt   ]];then ltl omcicli mib get 131 | tr -d '\r' | awk "$om04;$om01"
  elif [[ $1 = ver   ]];then ltl omcicli mib get 7   | tr -d '\r' | awk "$om05;$om01"
  elif [[ $1 = ont   ]];then ltl omcicli mib get 256 | tr -d '\r' | awk "$om06;$om01"
  elif [[ $1 = pon   ]];then ltl diag gpon get onu-state
  elif [[ $1 = upt   ]];then ltl uptime -p
  else leh
  fi
}
function pfh { echo -e "pfs <param> [hours]\nPFSRB\t\tpfSense reboot\nfw[qsl]\t\tFirewall show Queues/Schedulers/Limiters\nip{46crd}\tshow ip4/ip6/config/route/discovery\ndsk\t\tshow disk usage\ndhcpc?6?\tpfSense logs dhcp[client]\ndns\t\tresolver\ngw\t\tgateways\nlogs?\t\tsystem[dhcp]\nlst\t\tlink-state"; }
function pfs { 
  local s=hrv-protectli;local i=${1:0:2};local r=${1:2}
  if   [[ $1 = PFSRB ]];then msh -q $s "/etc/rc.reboot"
  elif [[ $i = fw    ]];then shift;if [[ $r = q ]];then i=queue;elif [[ $r = l ]];then i=pipe;else i=sched;fi;i="ipfw $i show";[[ $# -gt 0 ]] && i="$i 0$(printf ',%i' $@)";echo "$i";msh -q $s "$i"
  elif [[ $i = ip    ]];then msh -q $s "/root/rt-pfsense-ip.sh $1"
  elif [[ $1 = dsk   ]];then msh -q $s "smartctl -a /dev/ada0|grep -E 'Model:|^ID#|^ *(5|9|187) +[A-Z]'"
  elif [[ $1 = dns   ]];then msh -q $s "/root/rt-pfsense-log-check.sh resolver ${2:-24}"
  elif [[ $1 = gw    ]];then msh -q $s "/root/rt-pfsense-log-check.sh gateways ${2:-24}"
  elif [[ $1 = dhcp || $1 = dhcp6 || $1 = dhcpc || $1 = dhcpc6 || $1 = log || $1 = logs || $1 = lst ]];then msh -q $s "/root/rt-pfsense-log-check.sh $1 ${2:-24}"
  else pfh
  fi
}
function san { local s=${1:-UP};ip -j addr|jq -r ".[]|select(.operstate==\"${s^^}\").ifname"|grep '^en'; }
function sa6 { local s=${1:-UP};ip -j addr|jq -r ".[]|select(.operstate==\"${s^^}\").addr_info.[]|select(.family==\"inet6\" and .scope==\"global\").local"; }
function ufz { echo "$B"|gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 -c $1; }
function zfu { echo "$B"|gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 -d $1 2>/dev/null; }
